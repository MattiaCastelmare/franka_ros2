Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: fr3_link0
    Frame Rate: 15

  Displays:

    - Class: rviz_default_plugins/Image
      Name: Hand State Debug
      Enabled: true
      Topic:
        Value: /handover/hand_debug_image
      Value: true
    # Gripper camera (D405): same overlay; empty when the D405 is not present.
    - Class: rviz_default_plugins/Image
      Name: Gripper Camera Debug (D405)
      Enabled: true
      Topic:
        Value: /handover/gripper_debug_image
      Value: true
