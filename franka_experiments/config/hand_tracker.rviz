Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 15

  Displays:

    - Class: rviz_default_plugins/Image
      Name: Hand State Debug
      Enabled: true
      Topic:
        Value: /handover/hand_state_debug_image
      Value: true