<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_experiments</name>
  <version>0.0.1</version>
  <description>Experiment launch files for Franka robots</description>
  <maintainer email="mattia@todo.todo">mattia</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS2 runtime dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>pymoveit2</exec_depend>
  <!-- move_group server (compute_fk / compute_cartesian_path services) is
       provided by franka_fr3_moveit_config's move_group.launch.py -->
  <exec_depend>franka_fr3_moveit_config</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_simulation</exec_depend>
  <exec_depend>franka_bringup</exec_depend>

  <!-- Optional: camera driver and calibration (needed for Phase 3 obstacle CBF) -->
  <!-- exec_depend>realsense2_camera</exec_depend -->
  <!-- exec_depend>apriltag_ros</exec_depend -->

  <!-- Python dependencies (install via pip if not available via rosdep):
       pinocchio, qpsolvers, osqp, numpy, scipy, matplotlib, opencv-python, pyyaml -->

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
