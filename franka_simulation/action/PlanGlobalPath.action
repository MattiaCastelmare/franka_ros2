# Goal
geometry_msgs/PoseStamped target_pose
string planner_id "RRTConnect"  # OMPL planner
float32 planning_time 5.0
int32 max_attempts 3
---
# Result
int32 error_code  # MoveIt error codes
moveit_msgs/RobotTrajectory trajectory
nav_msgs/Path waypoints_path  # Waypoints estratti per Servo
float64 planning_time
int32 num_waypoints
---
# Feedback
string current_state  # "planning", "validating"
int32 attempt_number