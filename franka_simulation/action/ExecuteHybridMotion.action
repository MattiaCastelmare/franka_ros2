# Goal
geometry_msgs/PoseStamped target_pose
bool use_hybrid_planning  # true = global+local, false = direct MoveIt
float32 velocity_scaling 0.3
float32 acceleration_scaling 0.3

---
# Result  
int32 error_code
string error_message
geometry_msgs/Pose final_pose
float64 planning_time
float64 execution_time
int32 replans_count

# Error codes
int32 SUCCESS = 0
int32 PLANNING_FAILED = 1
int32 EXECUTION_FAILED = 2
int32 COLLISION_DETECTED = 3
int32 SERVO_TIMEOUT = 4

---
# Feedback
string current_phase  # "global_planning", "local_execution", "replanning"
float32 progress  # 0.0 - 1.0
geometry_msgs/Pose current_pose
float32 distance_to_goal
float32 collision_distance  # Distanza minima da ostacoli