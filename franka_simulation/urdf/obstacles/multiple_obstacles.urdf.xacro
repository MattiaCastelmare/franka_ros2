<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="collision_obstacles">
  
  <!-- ============================================= -->
  <!-- CONFIGURAZIONE CENTRALIZZATA DEGLI OSTACOLI  -->
  <!-- Modifica SOLO questi valori per cambiare     -->
  <!-- posizione e dimensioni degli ostacoli        -->
  <!-- ============================================= -->
  
  <!-- OSTACOLO 1 - Box Rosso principale -->
  <xacro:property name="obstacle1_pos_x" value="0.5"/>
  <xacro:property name="obstacle1_pos_y" value="0.0"/>
  <xacro:property name="obstacle1_pos_z" value="0.4"/>
  <xacro:property name="obstacle1_size_x" value="0.15"/>
  <xacro:property name="obstacle1_size_y" value="0.15"/>
  <xacro:property name="obstacle1_size_z" value="0.3"/>
  
  <!-- OSTACOLO 2 - Box Blu laterale -->
  <xacro:property name="obstacle2_pos_x" value="0.3"/>
  <xacro:property name="obstacle2_pos_y" value="0.3"/>
  <xacro:property name="obstacle2_pos_z" value="0.2"/>
  <xacro:property name="obstacle2_size_x" value="0.1"/>
  <xacro:property name="obstacle2_size_y" value="0.1"/>
  <xacro:property name="obstacle2_size_z" value="0.2"/>
  
  <!-- TAVOLO - Piano grigio -->
  <xacro:property name="table_pos_x" value="0.4"/>
  <xacro:property name="table_pos_y" value="0.0"/>
  <xacro:property name="table_pos_z" value="-0.025"/>
  <xacro:property name="table_size_x" value="1.0"/>
  <xacro:property name="table_size_y" value="1.0"/>
  <xacro:property name="table_size_z" value="0.05"/>
  
  <!-- ============================================= -->
  <!-- DEFINIZIONE ROBOT - Non modificare sotto     -->
  <!-- ============================================= -->
  
  <!-- Link base -->
  <link name="world"/>
  
  <!-- OSTACOLO 1 -->
  <link name="obstacle_1">
    <visual>
      <geometry>
        <box size="${obstacle1_size_x} ${obstacle1_size_y} ${obstacle1_size_z}"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${obstacle1_size_x} ${obstacle1_size_y} ${obstacle1_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.0075" ixy="0" ixz="0" iyy="0.0075" iyz="0" izz="0.00375"/>
    </inertial>
  </link>
  
  <joint name="obstacle_1_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_1"/>
    <origin xyz="${obstacle1_pos_x} ${obstacle1_pos_y} ${obstacle1_pos_z}" rpy="0 0 0"/>
  </joint>
  
  <!-- OSTACOLO 2 -->
  <link name="obstacle_2">
    <visual>
      <geometry>
        <box size="${obstacle2_size_x} ${obstacle2_size_y} ${obstacle2_size_z}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${obstacle2_size_x} ${obstacle2_size_y} ${obstacle2_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
    </inertial>
  </link>
  
  <joint name="obstacle_2_joint" type="fixed">
    <parent link="world"/>
    <child link="obstacle_2"/>
    <origin xyz="${obstacle2_pos_x} ${obstacle2_pos_y} ${obstacle2_pos_z}" rpy="0 0 0"/>
  </joint>
  
  <!-- TAVOLO -->
  <link name="table">
    <visual>
      <geometry>
        <box size="${table_size_x} ${table_size_y} ${table_size_z}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${table_size_x} ${table_size_y} ${table_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.84" ixy="0" ixz="0" iyy="0.84" iyz="0" izz="1.66"/>
    </inertial>
  </link>
  
  <joint name="table_joint" type="fixed">
    <parent link="world"/>
    <child link="table"/>
    <origin xyz="${table_pos_x} ${table_pos_y} ${table_pos_z}" rpy="0 0 0"/>
  </joint>
  
  <!-- Proprietà Gazebo -->
  <gazebo reference="obstacle_1">
    <material>Gazebo/Red</material>
    <static>true</static>
  </gazebo>
  
  <gazebo reference="obstacle_2">
    <material>Gazebo/Blue</material>
    <static>true</static>
  </gazebo>
  
  <gazebo reference="table">
    <material>Gazebo/Grey</material>
    <static>true</static>
  </gazebo>
  
</robot>