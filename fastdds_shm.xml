<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
<!-- Shared memory with 64 MB segments (a 1280x720 frame is 2.7 MB; the default 0.5 MB segments and UDP alone
     drop ~1.3 of 30 camera frames per second), UDP kept for processes outside the launch. -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>shm_big</transport_id>
            <type>SHM</type>
            <segment_size>67108864</segment_size>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>udp</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="default_participant" is_default_profile="true">
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>shm_big</transport_id>
                <transport_id>udp</transport_id>
            </userTransports>
        </rtps>
    </participant>
</profiles>
