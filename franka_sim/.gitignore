# Training artifacts — regenerated by train.py / export_onnx.py, never committed.
# Trained models travel as a tarball outside git (see HANDOFF.md).
runs/*
models/
*.onnx
*.zip

# Exception: the evaluation / batch-launch scripts and their model lists are code.
# Logs, traces, videos and pages under runs/eval_all stay ignored.
!runs/eval_all/
runs/eval_all/**
!runs/eval_all/**/
!runs/eval_all/**/*.py
!runs/eval_all/**/*.sh
!runs/eval_all/c1/list_*.txt
!runs/eval_all/c2/list_*.txt
!runs/eval_all/c2/final_table.txt

# Python caches
__pycache__/
*.pyc
